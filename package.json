{
  "name": "money-collection-api",
  "version": "1.0.0",
  "description": "Node.js + MySQL API for Money Calculator app (data sync only — no interest calculations)",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js",
    "dev": "node --watch index.js",
    "db:migrate": "node src/db/migrate.js && node src/db/migrate_auth.js",
    "db:seed": "node src/db/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemon": "^3.1.14"
  }
}
