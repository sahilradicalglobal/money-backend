# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=money_collection

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Web Client ID — same as Android default_web_client_id)
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# CORS (comma-separated origins, use * for dev)
CORS_ORIGIN=*
